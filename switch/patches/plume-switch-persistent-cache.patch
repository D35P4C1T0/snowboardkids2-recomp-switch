+        "sdmc:/switch/snowboardkids2-recompiled/cache/nvk-pipeline-cache.bin";
+    static constexpr const char *SwitchPipelineCacheTemporaryPath =
+        "sdmc:/switch/snowboardkids2-recompiled/cache/nvk-pipeline-cache.tmp";
+    static constexpr size_t SwitchPipelineCacheSizeLimit = 64U * 1024U * 1024U;
+
+    static bool loadSwitchPipelineCache(std::vector<uint8_t> &bytes) {
+        FILE *file = std::fopen(SwitchPipelineCachePath, "rb");
+        if (file == nullptr) {
+            return false;
+        }
+
+        bool loaded = false;
+        if ((std::fseek(file, 0, SEEK_END) == 0)) {
+            const long fileSize = std::ftell(file);
+            if ((fileSize > 0) && (size_t(fileSize) <= SwitchPipelineCacheSizeLimit) &&
+                (std::fseek(file, 0, SEEK_SET) == 0)) {
+                bytes.resize(size_t(fileSize));
+                loaded = std::fread(bytes.data(), 1, bytes.size(), file) == bytes.size();
+            }
+        }
+
+        std::fclose(file);
+        if (!loaded) {
+            bytes.clear();
+        }
+
+        return loaded;
+    }
+
+    static bool storeSwitchPipelineCache(const uint8_t *bytes, size_t byteCount) {
+        FILE *file = std::fopen(SwitchPipelineCacheTemporaryPath, "wb");
+        if (file == nullptr) {
+            return false;
+        }
+
+        const bool written = (std::fwrite(bytes, 1, byteCount, file) == byteCount) &&
+            (std::fflush(file) == 0);
+        const bool closed = std::fclose(file) == 0;
+        if (!written || !closed) {
+            std::remove(SwitchPipelineCacheTemporaryPath);
+            return false;
+        }
+
+        if (std::rename(SwitchPipelineCacheTemporaryPath, SwitchPipelineCachePath) != 0) {
+            std::remove(SwitchPipelineCacheTemporaryPath);
+            return false;
+        }
+
+        return true;
+    }
 
