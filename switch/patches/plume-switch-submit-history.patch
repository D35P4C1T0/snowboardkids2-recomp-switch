@@ -98,6 +98,57 @@ namespace plume {
         std::snprintf(SwitchSubmitContext, sizeof(SwitchSubmitContext), "%s",
             context != nullptr ? context : "unlabeled");
     }
+
+    static void recordSwitchSubmit(VulkanQueue::SubmitRecord &record, uint32_t sequence, const char *context) {
+        record.sequence = sequence;
+        std::snprintf(record.context, sizeof(record.context), "%s", context);
+    }
+
+    static void formatSwitchSubmitHistory(const std::array<VulkanQueue::SubmitRecord, 4> &history,
+        uint32_t cursor, char *output, size_t outputSize)
+    {
+        size_t outputLength = 0;
+        output[0] = '\0';
+        const uint32_t available = std::min(cursor, uint32_t(history.size()));
+        for (uint32_t offset = 0; offset < available; offset++) {
+            const uint32_t index = (cursor - 1U - offset) % uint32_t(history.size());
+            const VulkanQueue::SubmitRecord &record = history[index];
+            const int written = std::snprintf(output + outputLength, outputSize - outputLength,
+                "%s#%u '%s'", (offset == 0) ? "" : " | ", record.sequence, record.context);
+            if (written < 0) {
+                break;
+            }
+
+            const size_t writtenSize = size_t(written);
+            if (writtenSize >= (outputSize - outputLength)) {
+                outputLength = outputSize - 1;
+                break;
+            }
+
+            outputLength += writtenSize;
+        }
+    }
+
+    static void logSwitchSubmitHistory(VulkanQueue *queue) {
+        char submittedMessage[1200]{};
+        char completedMessage[1200]{};
+        {
+            const std::scoped_lock queueLock(*queue->mutex);
+            char submittedHistory[1100]{};
+            char completedHistory[1100]{};
+            formatSwitchSubmitHistory(queue->submittedHistory, queue->submittedHistoryCursor,
+                submittedHistory, sizeof(submittedHistory));
+            formatSwitchSubmitHistory(queue->completedHistory, queue->completedHistoryCursor,
+                completedHistory, sizeof(completedHistory));
+            std::snprintf(submittedMessage, sizeof(submittedMessage),
+                "fatal-history: last submitted %s", submittedHistory);
+            std::snprintf(completedMessage, sizeof(completedMessage),
+                "fatal-history: last completed %s", completedHistory);
+        }
+
+        switch_log_checkpoint(submittedMessage, false);
+        switch_log_checkpoint(completedMessage, false);
+    }
 #endif
 
