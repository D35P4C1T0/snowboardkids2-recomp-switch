new file mode 100644
--- /dev/null
+++ b/src/shaders/SwitchFramebufferColorCopyPS.hlsl
@@ -0,0 +1,26 @@
+//
+// RT64
+//
+
+#include "Formats.hlsli"
+#include "Random.hlsli"
+#include "shared/rt64_switch_framebuffer_copy.h"
+
+[[vk::push_constant]] ConstantBuffer<SwitchFramebufferColorCopyCB> gConstants : register(b0);
+Texture2D<float4> gInput : register(t1);
+
+float4 PSMain(in float4 pos : SV_Position, in float2 uv : TEXCOORD0) : SV_TARGET {
+    const uint2 coord = uint2(pos.xy);
+    const uint dstIndex = coord.y * gConstants.rowWidth + coord.x;
+    // MAGICSQ, BAYER, and DISABLE never consume the random value. Avoid the
+    // expensive 16-round TEA sequence for those overwhelmingly common modes.
+    const uint randomSeed = (gConstants.ditherPattern == 2)
+        ? initRand(gConstants.ditherRandomSeed, dstIndex, 16)
+        : 0;
+    const uint dither = DitherPatternValue(gConstants.ditherPattern, coord, randomSeed);
+    const uint nativeValue = Float4ToRGBA16(gInput.Load(uint3(coord, 0)), dither, gConstants.usesHDR != 0);
+
+    // Preserve native bytes exactly through an RGBA8 render target.
+    return float4(((nativeValue >> 8) & 0xFF) / 255.0f,
+        (nativeValue & 0xFF) / 255.0f, 0.0f, 1.0f);
+}
