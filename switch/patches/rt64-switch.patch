+
+    void Framebuffer::copyNativeToRAMCPU(uint8_t *dst, uint32_t dstRowWidth, uint32_t dstRowStart, uint32_t dstRowEnd) {
+        assert(dst != nullptr);
+        assert(dstRowStart < height);
+        assert(dstRowEnd <= height);
+
+        uint8_t *dstBytes = dst + dstRowStart * imageRowBytes(dstRowWidth);
+        uint32_t *dstWords = reinterpret_cast<uint32_t *>(dstBytes);
+        const uint32_t bytesToSwap = (dstRowEnd - dstRowStart) * imageRowBytes(dstRowWidth);
