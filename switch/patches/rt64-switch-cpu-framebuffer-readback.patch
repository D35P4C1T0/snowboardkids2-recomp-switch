+        3, 7, 2, 6,
+        7, 3, 6, 2
+    };
+
+    constexpr uint32_t SwitchDitherPatternMagicSquare[16] = {
+        0, 6, 1, 7,
+        4, 2, 5, 3,
+        3, 5, 2, 4,
+        7, 1, 6, 0
+    };
+
+    uint32_t switchInitRand(uint32_t value0, uint32_t value1) {
+        uint32_t sum = 0;
+        for (uint32_t iteration = 0; iteration < 16; iteration++) {
+            sum += 0x9e3779b9U;
+            value0 += ((value1 << 4) + 0xa341316cU) ^ (value1 + sum) ^ ((value1 >> 5) + 0xc8013ea4U);
+            value1 += ((value0 << 4) + 0xad90777dU) ^ (value0 + sum) ^ ((value0 >> 5) + 0x7e95761eU);
+        }
+
+        return value0;
+    }
+
+    uint32_t switchDitherValue(uint32_t pattern, uint32_t x, uint32_t y, uint32_t randomSeed) {
+        const uint32_t index = ((y & 3U) << 2U) + (x & 3U);
+        switch (pattern) {
+        case 0:
+            return SwitchDitherPatternMagicSquare[index];
+        case 1:
+            return SwitchDitherPatternBayer[index];
+        case 2:
+            return randomSeed & 7U;
+        default:
+            return 0;
+        }
+    }
+
+    uint16_t switchEncodeRGBA16(const uint8_t *source, uint32_t dither) {
+        uint32_t red = source[0];
+        uint32_t green = source[1];
+        uint32_t blue = source[2];
+        const uint32_t alpha = (uint32_t(source[3]) & 4U) ? 1U : 0U;
+        red = std::min(red + dither, 255U) >> 3U;
+        green = std::min(green + dither, 255U) >> 3U;
+        blue = std::min(blue + dither, 255U) >> 3U;
+        return uint16_t((red << 11U) | (green << 6U) | (blue << 1U) | alpha);
+    }
+
+    uint16_t switchEncodeDepth16(float inputDepth) {
+        if (!std::isfinite(inputDepth)) {
+            inputDepth = 0.0f;
+        }
+
+        const float depth = std::clamp(inputDepth, 0.0f, 1.0f);
+        const uint32_t fixedDepth = uint32_t(std::nearbyint(depth * (32768.0f * 8.0f - 1.0f)));
+        const uint32_t invertedShiftedDepth = ~(fixedDepth << 14U);
+        uint32_t exponent = 0;
+        uint32_t leadingMask = 0x80000000U;
+        while ((exponent < 7U) && ((invertedShiftedDepth & leadingMask) == 0U)) {
+            exponent++;
+            leadingMask >>= 1U;
+        }
+
+        const uint32_t mantissa = fixedDepth >> (6U - std::min(6U, exponent));
+        return uint16_t((exponent << 13U) | ((mantissa << 2U) & 0x1FFCU));
+    }
