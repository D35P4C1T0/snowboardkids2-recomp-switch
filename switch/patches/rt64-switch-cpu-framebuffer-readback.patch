+        assert(switchTextureReadbackSize == G_IM_SIZ_16b);
+        assert((switchTextureReadbackN64Format == G_IM_FMT_RGBA) || (switchTextureReadbackN64Format == G_IM_FMT_DEPTH));
+
+        const uint32_t rowWidth = switchTextureReadbackRowWidth;
+        const uint32_t rowStart = switchTextureReadbackRowStart;
+        const uint32_t rowCount = switchTextureReadbackRowEnd - rowStart;
+        const uint32_t sourcePixelSize = RenderFormatSize(switchTextureReadbackRenderFormat);
+        const uint32_t sourceByteCount = rowWidth * rowCount * sourcePixelSize;
+        assert(sourceByteCount <= switchTextureReadbackBufferSize);
