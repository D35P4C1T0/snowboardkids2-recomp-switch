     void VulkanBuffer::unmap(uint32_t subresource, const RenderRange *writtenRange) {
         const VkDeviceSize offset = (writtenRange != nullptr) ? writtenRange->begin : 0;
         const VkDeviceSize size = (writtenRange != nullptr) ? (writtenRange->end - writtenRange->begin) : VK_WHOLE_SIZE;
+#if defined(__SWITCH__)
+        if ((desc.heapType == RenderHeapType::UPLOAD) && (switchMappedData != nullptr)) {
+            const size_t cleanSize = (size == VK_WHOLE_SIZE) ? size_t(desc.size) : size_t(size);
+            armDCacheClean(static_cast<uint8_t *>(switchMappedData) + offset, cleanSize);
+        }
+#endif
         VkResult res = vmaFlushAllocation(device->allocator, allocation, offset, size);
         if (res != VK_SUCCESS) {
             fprintf(stderr, "vmaFlushAllocation failed with error code 0x%X.\n", res);
         }
 
         vmaUnmapMemory(device->allocator, allocation);
+#if defined(__SWITCH__)
+        switchMappedData = nullptr;
+#endif
     }
 
