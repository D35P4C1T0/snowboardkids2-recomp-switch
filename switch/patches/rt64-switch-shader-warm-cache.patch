+    }
+
+#if defined(__SWITCH__)
+    namespace {
+        constexpr uint64_t SwitchShaderDescriptionCacheMagic = 0x3153485344343652ULL;
+        constexpr uint32_t SwitchShaderDescriptionCacheVersion = 1;
+        constexpr uint32_t SwitchShaderDescriptionCacheLimit = 4096;
+
+#pragma pack(push, 1)
+        struct SwitchShaderDescriptionCacheHeader {
+            uint64_t magic;
+            uint32_t version;
+            uint32_t recordSize;
+        };
+
+        struct SwitchShaderDescriptionCacheRecord {
+            uint64_t hash;
+            ShaderDescription description;
+        };
+#pragma pack(pop)
+
+        static_assert(std::is_trivially_copyable_v<ShaderDescription>);
+    }
+
+    void RasterShaderCache::loadPersistentShaderDescriptions() {
+        if (descriptionCachePath.empty()) {
+            return;
+        }
+
+        std::vector<ShaderDescription> cachedDescriptions;
+        {
+            const std::unique_lock<std::mutex> cacheLock(descriptionCacheMutex);
+            persistedShaderHashes.clear();
+            std::ifstream cacheFile(descriptionCachePath, std::ios::binary);
+            SwitchShaderDescriptionCacheHeader header{};
+            const bool validHeader = cacheFile.read(reinterpret_cast<char *>(&header), sizeof(header)) &&
+                (header.magic == SwitchShaderDescriptionCacheMagic) &&
+                (header.version == SwitchShaderDescriptionCacheVersion) &&
+                (header.recordSize == sizeof(SwitchShaderDescriptionCacheRecord));
+
+            if (validHeader) {
+                SwitchShaderDescriptionCacheRecord record{};
+                while ((cachedDescriptions.size() < SwitchShaderDescriptionCacheLimit) &&
+                    cacheFile.read(reinterpret_cast<char *>(&record), sizeof(record)))
+                {
+                    record.description.maskUnusedParameters();
+                    if (record.hash == record.description.hash()) {
+                        cachedDescriptions.emplace_back(record.description);
+                        persistedShaderHashes[record.hash] = true;
+                    }
+                }
+            }
+
+            // Canonicalize the file on every load so an interrupted final
+            // record can never misalign descriptions appended by this run.
+            cacheFile.close();
+            std::error_code pathError;
+            std::filesystem::create_directories(descriptionCachePath.parent_path(), pathError);
+            std::ofstream normalizedCacheFile(descriptionCachePath, std::ios::binary | std::ios::trunc);
+            const SwitchShaderDescriptionCacheHeader newHeader = {
+                SwitchShaderDescriptionCacheMagic,
+                SwitchShaderDescriptionCacheVersion,
+                uint32_t(sizeof(SwitchShaderDescriptionCacheRecord))
+            };
+            descriptionCacheReady = bool(normalizedCacheFile.write(
+                reinterpret_cast<const char *>(&newHeader), sizeof(newHeader)));
+            for (const ShaderDescription &description : cachedDescriptions) {
+                const SwitchShaderDescriptionCacheRecord record = {
+                    description.hash(), description
+                };
+                descriptionCacheReady = descriptionCacheReady && bool(normalizedCacheFile.write(
+                    reinterpret_cast<const char *>(&record), sizeof(record)));
+            }
+            normalizedCacheFile.flush();
+        }
+
+        for (const ShaderDescription &description : cachedDescriptions) {
+            submit(description);
+        }
+
+        char cacheMessage[160]{};
+        std::snprintf(cacheMessage, sizeof(cacheMessage),
+            "rt64 shader warm cache: loaded %zu descriptions", cachedDescriptions.size());
+        switch_log_checkpoint(cacheMessage, false);
     }
+
+    void RasterShaderCache::persistShaderDescription(const ShaderDescription &desc) {
+        if (descriptionCachePath.empty()) {
+            return;
+        }
+
+        const uint64_t shaderHash = desc.hash();
+        const std::unique_lock<std::mutex> cacheLock(descriptionCacheMutex);
+        bool &alreadyPersisted = persistedShaderHashes[shaderHash];
+        if (alreadyPersisted || !descriptionCacheReady) {
+            return;
+        }
+
+        const SwitchShaderDescriptionCacheRecord record = { shaderHash, desc };
+        std::ofstream cacheFile(descriptionCachePath, std::ios::binary | std::ios::app);
+        if (cacheFile.write(reinterpret_cast<const char *>(&record), sizeof(record))) {
+            cacheFile.flush();
+            alreadyPersisted = true;
+        }
+    }
+#endif
 };
