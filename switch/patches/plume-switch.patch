+    static bool storeSwitchPipelineCache(const uint8_t *bytes, size_t byteCount) {
+        FILE *file = std::fopen(SwitchPipelineCacheTemporaryPath, "wb");
+        if (file == nullptr) {
+            return false;
+        }
+
+        const bool written = (std::fwrite(bytes, 1, byteCount, file) == byteCount) &&
+            (std::fflush(file) == 0);
+        const bool closed = std::fclose(file) == 0;
+        if (!written || !closed) {
+            std::remove(SwitchPipelineCacheTemporaryPath);
