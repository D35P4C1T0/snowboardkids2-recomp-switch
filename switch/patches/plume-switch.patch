     bool VulkanSwapChain::needsResize() const {
+#   if defined(__SWITCH__)
+        // Horizon exposes one fixed application surface. Re-querying NWindow
+        // dimensions after framebuffer setup can report a transient/mismatched
+        // size and trigger a desktop-style recreation loop. Recreating a CPU-copy
+        // WSI swapchain on the same NWindow also lets old-swapchain teardown
+        // release the new framebuffer's buffers. Create it once and keep it.
+        return vk == VK_NULL_HANDLE;
+#   else
         uint32_t windowWidth, windowHeight;
         getWindowSize(windowWidth, windowHeight);
         return (vk == VK_NULL_HANDLE) || (windowWidth != width) || (windowHeight != height) || (requiredPresentMode != createdPresentMode);
+#   endif
     }
 
