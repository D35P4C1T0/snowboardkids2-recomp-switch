diff --git a/build-native-tools.sh b/build-native-tools.sh
index 4c11abf..a51129f 100644
--- a/build-native-tools.sh
+++ b/build-native-tools.sh
@@ -29,9 +29,14 @@ meson setup "$NB" \
   -Dstatic-libclc=all \
   "$@"
 
-# Build + install just the tools (and whatever they depend on). `ninja install` honors the
-# install-*-compiler options, placing mesa_clc + the precomp compiler on PATH.
-ninja -C "$NB"
-ninja -C "$NB" install
+# Only the two build-machine tools are needed. Building Mesa's native Vulkan
+# shared object also pulls the Switch-only logging hook installed by the WSI
+# patch, which is intentionally unresolved in a Linux host driver.
+ninja -C "$NB" \
+  src/compiler/clc/mesa_clc \
+  src/compiler/spirv/vtn_bindgen
+mkdir -p "$PREFIX/bin"
+install -m 755 "$NB/src/compiler/clc/mesa_clc" "$PREFIX/bin/mesa_clc"
+install -m 755 "$NB/src/compiler/spirv/vtn_bindgen" "$PREFIX/bin/vtn_bindgen"
 echo "=== installed native tools ==="
 ls -la "$PREFIX/bin/" | grep -iE 'clc|precomp|nak' || true
