diff --git a/winsys/wsi/wsi_common_switch.c b/winsys/wsi/wsi_common_switch.c
index 5136fe3..f8fd675 100644
--- a/winsys/wsi/wsi_common_switch.c
+++ b/winsys/wsi/wsi_common_switch.c
@@ -524,10 +524,28 @@ wsi_switch_surface_create_swapchain(VkIcdSurfaceBase *icd_surface,
     * scanout buffer (build the NvGraphicBuffer with kind=0xfe + the image's NIL
     * layout, then nwindowConfigureBuffer). slot == image index (identity). If any
     * image can't be wrapped, fall back to the libnx-framebuffer CPU-copy path. */
-   nvFenceInit();   /* required before nwindowDequeueBuffer / nvMultiFenceWait */
-   nwindowSetDimensions(chain->window, chain->extent.width, chain->extent.height);
-   chain->zero_copy = true;
-   for (uint32_t i = 0; i < num_images; i++) {
+   dusk_switch_log("[wsi] swapchain images created; configuring native window\n");
+   /* The DRM shim initializes nvFence as part of device bring-up. Calling
+    * nvFenceInit again here leaks a service-guard reference per swapchain. */
+   Result dimensions_rc = nwindowSetDimensions(chain->window,
+                                                chain->extent.width,
+                                                chain->extent.height);
+   {
+      char msg[128];
+      snprintf(msg, sizeof(msg), "[wsi] nwindowSetDimensions -> 0x%x\n",
+               (unsigned)dimensions_rc);
+      dusk_switch_log(msg);
+   }
+
+   /* Zero-copy scanout depends on undocumented NvGraphicBuffer layout details
+    * and is not stable on every Horizon/libnx combination. Keep the proven
+    * linear framebuffer path selectable for correctness-first ports. */
+   const char *force_cpu_copy = getenv("NVK_SWITCH_WSI_CPU_COPY");
+   chain->zero_copy = force_cpu_copy == NULL || strcmp(force_cpu_copy, "0") == 0;
+   if (!chain->zero_copy)
+      dusk_switch_log("[wsi] CPU-copy fallback forced by environment\n");
+
+   for (uint32_t i = 0; chain->zero_copy && i < num_images; i++) {
       if (!wsi_switch_build_graphic_buffer(&chain->images[i].gb,
                                            chain->images[i].base.image,
                                            chain->vk_format, chain->extent)) {
@@ -545,18 +563,20 @@ wsi_switch_surface_create_swapchain(VkIcdSurfaceBase *icd_surface,
       dusk_switch_log("[wsi] zero-copy ENABLED (block-linear nwindow scanout, kind=0xfe)\n");
    } else {
-      printf("[wsi-zc] zero-copy FAILED -> CPU-copy fallback\n"); fflush(stdout);
+      dusk_switch_log("[wsi] entering CPU-copy framebuffer setup\n");
       /* Fallback: reset the nwindow, then libnx framebuffer + CPU-copy present. */
       for (uint32_t i = 0; i < num_images; i++) chain->images[i].configured = false;
       nwindowReleaseBuffers(chain->window);
+      dusk_switch_log("[wsi] nwindow buffers released\n");
       u32 pixfmt = (chain->vk_format == VK_FORMAT_B8G8R8A8_UNORM)
                    ? PIXEL_FORMAT_BGRA_8888 : PIXEL_FORMAT_RGBA_8888;
       Result rc = framebufferCreate(&chain->fb, chain->window,
                                     chain->extent.width, chain->extent.height,
                                     pixfmt, num_images);
       if (R_FAILED(rc)) { result = VK_ERROR_INITIALIZATION_FAILED; goto fail; }
+      dusk_switch_log("[wsi] linear framebuffer created\n");
       framebufferMakeLinear(&chain->fb);
       chain->fb_created = true;
-      dusk_switch_log("[wsi] zero-copy FAILED -> CPU-copy fallback\n");
+      dusk_switch_log("[wsi] CPU-copy framebuffer ready\n");
    }
 
    *swapchain_out = &chain->base;
