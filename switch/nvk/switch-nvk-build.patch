+/* A channel reset can advance its syncpoint despite failed GPU work. Never
+ * treat a completed fence as success until the native error notifier is clear.
+ * Keep detailed native faults available without enabling noisy NVK_TRACE.
+ */
+static int shim_channel_check_error(struct shim_channel *ch)
+{
+   NvNotification notification = {0};
+   Result rc = nvGpuChannelGetErrorNotification(&ch->chan, &notification);
+   if (R_FAILED(rc) || (!notification.info32 && !notification.info16))
+      return 0; /* No pending notification is reported as a libnx error. */
+
+   if (g_drm_shim_log_sink) {
+      char message[256];
+      snprintf(message, sizeof(message),
+         "NVK channel fault: notification=%u/%u status=0x%x timestamp=%llu",
+         notification.info32, notification.info16, notification.status,
+         (unsigned long long)notification.timestamp);
+      g_drm_shim_log_sink(message);
+      NvError error = {0};
+      rc = nvGpuChannelGetErrorInfo(&ch->chan, &error);
+      snprintf(message, sizeof(message), "NVK native fault: result=0x%x type=%u", rc, error.type);
+      g_drm_shim_log_sink(message);
+      if (R_SUCCEEDED(rc)) {
+         /* Native error types follow the libnx/deko3d channel ABI. The outer
+          * notification alone does not distinguish an MMU page fault from a
+          * graphics trap (both can arrive as notification 31). */
+         if (error.type == 1) {
+            snprintf(message, sizeof(message),
+               "NVK page fault: address=0x%02x%08x access=%s info=0x%08x",
+               error.info[1], error.info[2], error.info[3] == 2 ? "write" : "read", error.info[0]);
+            g_drm_shim_log_sink(message);
+         } else if (error.type == 2) {
+            snprintf(message, sizeof(message),
+               "NVK method fault: class=0x%04x method=0x%04x data=0x%08x irq=0x%08x detail=0x%08x",
+               error.info[4], error.info[1] & 0xffff, error.info[3], error.info[0], error.info[2]);
+            g_drm_shim_log_sink(message);
+         } else if (error.type == 3) {
+            g_drm_shim_log_sink("NVK command fault: GPU rejected command list");
+         }
+         for (unsigned i = 0; i < ARRAY_SIZE_LOCAL(error.info); i += 4) {
+            size_t used = snprintf(message, sizeof(message), "NVK fault words[%u]:", i);
+            for (unsigned j = i; j < i + 4 && j < ARRAY_SIZE_LOCAL(error.info); j++)
+               used += snprintf(message + used, sizeof(message) - used, " %08x", error.info[j]);
+            g_drm_shim_log_sink(message);
+         }
+      }
+   }
+   return -EIO;
+}
+
+static void report_submit_status(const char *phase,
+                                 const NvFence *fence, Result result)
+{
+   if (!g_drm_shim_log_sink) return;
+   u32 current = 0;
+   Result read_result = nvioctlNvhostCtrl_SyncptRead(nvFenceGetFd(), fence->id, &current);
+   char message[256];
+   snprintf(message, sizeof(message),
+      "NVK %s: syncpt=%u target=%u current=%u result=0x%x read=0x%x",
+      phase, fence->id, fence->value, current, result, read_result);
+   g_drm_shim_log_sink(message);
+}
+
+static int shim_async_fence_result(uint32_t id, const NvFence *fence, int timeout_us)
+{
+   struct shim_channel *ch = channel_lookup(id);
+   if (!ch || ch->pending.failed) return -EIO;
+   if (shim_channel_check_error(ch)) { ch->pending.failed = true; return -EIO; }
+   Result result = nvFenceWait(fence, timeout_us);
+   if (shim_channel_check_error(ch)) { ch->pending.failed = true; return -EIO; }
+   if (R_FAILED(result)) return timeout_us ? -EIO : -ETIME;
+   return 0;
+}
+
+static int shim_async_drain_all(void)
+{
+   if (!shim_async_enabled()) return 0;
+   for (unsigned i = 0; i < SHIM_MAX_CHANNELS; i++) {
+      if (g_dev.channels[i].used) {
+         int result = shim_async_reap(&g_dev.channels[i].pending, i + 1, 2);
+         if (result) return result;
+      }
    }
    return 0;
 }
