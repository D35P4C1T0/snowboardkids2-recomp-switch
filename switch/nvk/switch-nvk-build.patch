new file mode 100644
--- /dev/null
+++ b/winsys/switch_async.h
@@ -0,0 +1,85 @@
+#ifndef SWITCH_ASYNC_H
+#define SWITCH_ASYNC_H
+/* Bounded queues, with completion checks supplied by the native channel.
+ * Callers serialize updates with the device lock. Polls never block. */
+#define SHIM_ASYNC_QUEUE_LIMIT 2
+#define SHIM_ASYNC_POINT_LIMIT 8
+static int shim_async_fence_result(uint32_t channel, const NvFence *fence, int timeout_us);
+struct shim_async_queue {
+   NvFence fences[SHIM_ASYNC_QUEUE_LIMIT];
+   unsigned count;
+   bool failed;
+};
+struct shim_async_point { uint64_t value; NvFence fence; uint32_t channel; };
+struct shim_async_history {
+   struct shim_async_point points[SHIM_ASYNC_POINT_LIMIT];
+   unsigned count;
+   uint64_t submitted, completed;
+   bool available, completed_valid;
+};
+static inline bool shim_async_enabled(void)
+{
+   const char *value = getenv("NVK_SWITCH_ASYNC");
+   return value && *value == '1';
+}
+/* mode: 0 = poll; 1 = block on oldest; 2 = drain all. */
+static inline int shim_async_reap(struct shim_async_queue *queue, uint32_t channel, int mode)
+{
+   if (queue->failed) return -EIO;
+   while (queue->count) {
+      int result = shim_async_fence_result(channel, &queue->fences[0], mode ? 2000000 : 0);
+      if (result == -ETIME && !mode) return 0;
+      if (result) { queue->failed = true; return result; }
+      memmove(queue->fences, queue->fences + 1, (--queue->count) * sizeof(NvFence));
+      if (mode == 1) return 0;
+   }
+   return 0;
+}
+static inline int shim_async_progress(struct shim_async_history *history)
+{
+   while (history->count) {
+      const struct shim_async_point *point = &history->points[0];
+      int result = shim_async_fence_result(point->channel, &point->fence, 0);
+      if (result == -ETIME) return 0;
+      if (result) return result;
+      if (point->value > history->completed) history->completed = point->value;
+      history->completed_valid = true;
+      memmove(history->points, history->points + 1, (--history->count) * sizeof(*point));
+   }
+   return 0;
+}
+static inline int shim_async_attach(struct shim_async_history *history, uint64_t value,
+                                    const NvFence *fence, uint32_t channel)
+{
+   int result = shim_async_progress(history);
+   if (result) return result;
+   if (history->count == SHIM_ASYNC_POINT_LIMIT) {
+      const struct shim_async_point *oldest = &history->points[0];
+      result = shim_async_fence_result(oldest->channel, &oldest->fence, 2000000);
+      if (result) return result;
+      result = shim_async_progress(history);
+      if (result || history->count == SHIM_ASYNC_POINT_LIMIT) return result ? result : -EIO;
+   }
+   history->points[history->count++] = (struct shim_async_point){value, *fence, channel};
+   history->submitted = value;
+   history->available = true;
+   return 0;
+}
+static inline void shim_async_signal(struct shim_async_history *history, uint64_t value)
+{
+   memset(history, 0, sizeof(*history));
+   history->submitted = history->completed = value;
+   history->available = history->completed_valid = true;
+}
+static inline int shim_async_ready(struct shim_async_history *history, uint64_t value,
+                                   bool timeline, bool available, bool *ready)
+{
+   *ready = false;
+   int result = shim_async_progress(history);
+   if (result) return result;
+   if (!history->available) return 0;
+   if (available) *ready = !timeline || history->submitted >= value;
+   else *ready = history->completed_valid && (timeline ? history->completed >= value : !history->count);
+   return 0;
+}
+#endif
